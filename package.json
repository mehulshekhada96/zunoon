{
  "name": "zunoon-club",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "typecheck": "tsc --noEmit",
    "install:ci": "node scripts/install-ci.mjs",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "lucide-react": "^0.577.0",
    "next": "^16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "drizzle-orm": "0.45.2"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5.9.3",
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "json-rpc-2.0": "1.7.1",
    "raw-body": "3.0.2",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0",
    "react-server-dom-webpack": "19.3.0"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  }
}
